# ==============================================================================
# SMTP Email Configuration Environment Variables
# Copy this file to .env and configure your SMTP server credentials.
# DO NOT commit your actual .env file to version control.
# ==============================================================================

# SMTP Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL/TLS, 25 or 2525 for non-encrypted/testing)
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Security Settings
# Set SMTP_USE_TLS=true for STARTTLS (Port 587)
SMTP_USE_TLS=true
# Set SMTP_USE_SSL=true for implicit SSL (Port 465). Note: SMTP_USE_TLS and SMTP_USE_SSL are mutually exclusive.
SMTP_USE_SSL=false

# Sender Settings
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Security Operations Center

# Connection Timeout in seconds
SMTP_TIMEOUT=10

# ==============================================================================
# Common Provider Configuration Examples:
#
# 1. GMAIL (Requires App Password if 2FA is enabled):
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USE_TLS=true
#    SMTP_USE_SSL=false
#    SMTP_USERNAME=your_gmail_address@gmail.com
#    SMTP_PASSWORD=your_16_char_app_password
#
# 2. OUTLOOK / OFFICE 365:
#    SMTP_HOST=smtp.office365.com
#    SMTP_PORT=587
#    SMTP_USE_TLS=true
#    SMTP_USE_SSL=false
#    SMTP_USERNAME=your_email@outlook.com
#    SMTP_PASSWORD=your_password
#
# 3. MAILTRAP (Testing / Sandbox):
#    SMTP_HOST=sandbox.smtp.mailtrap.io
#    SMTP_PORT=2525
#    SMTP_USE_TLS=true
#    SMTP_USE_SSL=false
#    SMTP_USERNAME=your_mailtrap_username
#    SMTP_PASSWORD=your_mailtrap_password
#
# 4. SENDGRID:
#    SMTP_HOST=smtp.sendgrid.net
#    SMTP_PORT=587
#    SMTP_USE_TLS=true
#    SMTP_USE_SSL=false
#    SMTP_USERNAME=apikey
#    SMTP_PASSWORD=your_sendgrid_api_key
# ==============================================================================
